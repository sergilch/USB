<mxfile host="app.diagrams.net">
  <diagram name="USB PHY ULPI digital" id="usbphy1">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;USB 2.0 PHY (HS/FS/LS) - Digital Part with ULPI Interface (reference: USB3320)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="1500" height="40" as="geometry"/>
        </mxCell>

        <!-- Containers -->
        <mxCell id="cDig" value="&lt;b&gt;DIGITAL CORE&lt;/b&gt; (VDD18 domain; clk60 = ULPI domain, clk_bit = recovered CDR clock)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#336699;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#336699;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="1180" height="1010" as="geometry"/>
        </mxCell>
        <mxCell id="cAfe" value="&lt;b&gt;AFE (analog) - already in development&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1580" y="70" width="420" height="1010" as="geometry"/>
        </mxCell>

        <!-- External -->
        <mxCell id="link" value="&lt;b&gt;ULPI Link&lt;/b&gt;&lt;br&gt;(SoC / FPGA / USB controller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="140" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="sys" value="&lt;b&gt;System&lt;/b&gt;&lt;br&gt;REFCLK (19.2 / 24 / 26 MHz)&lt;br&gt;RESETB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="760" width="140" height="120" as="geometry"/>
        </mxCell>

        <!-- ULPI IF -->
        <mxCell id="ulpi" value="&lt;b&gt;ULPI Interface Controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;8-bit SDR, 60 MHz&lt;br&gt;DIR / NXT / STP handshake&lt;br&gt;Bus turnaround (TX / RX)&lt;br&gt;TXCMD decode (NOPID / PID)&lt;br&gt;RXCMD generation (LineState, VbusState, RxActive, RxError, ID)&lt;br&gt;Register read/write FSM&lt;br&gt;STP abort handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="200" height="270" as="geometry"/>
        </mxCell>

        <!-- TX path -->
        <mxCell id="tx1" value="&lt;b&gt;TX Holding Reg / Ctrl&lt;/b&gt;&lt;br&gt;TXCMD payload, NXT pacing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tx2" value="&lt;b&gt;SYNC + PID/Data Mux&lt;/b&gt;&lt;br&gt;SYNC pattern per speed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="130" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tx3" value="&lt;b&gt;Bit Stuffer&lt;/b&gt;&lt;br&gt;insert 0 after six 1s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="140" height="80" as="geometry"/>
