          <mxGeometry x="280" y="520" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="mode" value="&lt;b&gt;Mode / Termination Control&lt;/b&gt;&lt;br&gt;XcvrSelect[1:0], TermSelect, OpMode[1:0], SuspendM, Reset; DP 1.5k pull-up / HS term / pull-downs; speed select" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="520" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="hs" value="&lt;b&gt;HS Handshake / Chirp FSM&lt;/b&gt;&lt;br&gt;Device chirp-K, KJKJKJ detect, HS detect, SE0 reset detect, Suspend / Resume, remote wakeup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="520" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="otg" value="&lt;b&gt;OTG / VBUS Control&lt;/b&gt;&lt;br&gt;ID pull-up, DrvVbus, Charge / Discharge VBUS, SessValid, SessEnd, VbusValid, IdGnd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="520" width="170" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ls" value="&lt;b&gt;Line State / Event Detector&lt;/b&gt;&lt;br&gt;LineState[1:0] sync + debounce, squelch, HS disconnect, RxActive / RxError, HostDisconnect to RXCMD / interrupt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
