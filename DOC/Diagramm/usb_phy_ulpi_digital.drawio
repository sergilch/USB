        </mxCell>
        <mxCell id="rx4" value="&lt;b&gt;EOP Detect + RxError Check&lt;/b&gt;&lt;br&gt;RxActive framing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
