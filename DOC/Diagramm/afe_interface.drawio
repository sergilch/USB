<mxfile host="app.diagrams.net">
  <diagram name="AFE Interface" id="afeif1">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;AFE INTERFACE - Digital / Analog Boundary Unit (USB 2.0 PHY)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1300" height="40" as="geometry"/>
        </mxCell>

        <!-- Containers -->
        <mxCell id="cDig" value="&lt;b&gt;DIGITAL CORE&lt;/b&gt; (VDD18)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#336699;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#336699;" vertex="1" parent="1">
          <mxGeometry x="10" y="70" width="230" height="1570" as="geometry"/>
        </mxCell>
        <mxCell id="cIf" value="&lt;b&gt;AFE INTERFACE&lt;/b&gt; (VDD18 logic | level shifter / isolation band)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="560" height="1570" as="geometry"/>
        </mxCell>
        <mxCell id="cAfe" value="&lt;b&gt;AFE (analog, VDDA)&lt;/b&gt; - already in development" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="70" width="400" height="1570" as="geometry"/>
        </mxCell>

        <!-- External digital neighbours -->
        <mxCell id="x1" value="&lt;b&gt;Serializer&lt;/b&gt;&lt;br&gt;(TX datapath)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="x2" value="&lt;b&gt;Deserializer&lt;/b&gt;&lt;br&gt;(RX datapath)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="xclk" value="&lt;b&gt;Clock / Reset / Power Mgmt&lt;/b&gt;&lt;br&gt;REFCLK select, CLKOUT 60 MHz, POR + reset sync, clock gating, power-good" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="430" width="210" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="xcfg" value="&lt;b&gt;Config / Status Bus&lt;/b&gt;&lt;br&gt;(Register File)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="880" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="xls" value="&lt;b&gt;Line State / Event Detector&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1030" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="xmode" value="&lt;b&gt;Mode / Termination Control&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1180" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="xotg" value="&lt;b&gt;OTG / VBUS Control&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1330" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="xdft" value="&lt;b&gt;DFT / Test Modes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1480" width="210" height="120" as="geometry"/>
        </mxCell>

        <!-- AFE interface logic (VDD18) -->
        <mxCell id="l1" value="&lt;b&gt;TX Data Boundary&lt;/b&gt;&lt;br&gt;Retiming flops on clk_bit (480 MHz): txd, tx_en, tx_se0&lt;br&gt;tx_speed[1:0] decode (HS / FS / LS) selects driver mode&lt;br&gt;Clamp to idle when TX is disabled or isolated&lt;br&gt;Matched-skew, glitch-free outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="130" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;RX Data Capture / Clock Buffer&lt;/b&gt;&lt;br&gt;Recovered clock buffer (clk_bit root, balanced to RX capture flops)&lt;br&gt;Capture flops on clk_bit; CDC is done later by the Elastic Buffer&lt;br&gt;Data gated until CDR lock (rx_valid_lock)&lt;br&gt;Optional duty / skew monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="280" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;PLL / CDR Control + Clock Interface&lt;/b&gt;&lt;br&gt;refsel[1:0] (e.g. 19.2 / 24 / 26 MHz) -&gt; feedback-divider code&lt;br&gt;pll_en / cdr_en sequencing, CDR reset and bandwidth controls&lt;br&gt;pll_lock sync + lock filter (N stable cycles), loss-of-lock flag&lt;br&gt;clk60 / clk_bit output buffers toward Clock Mgmt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;Reset Synchronizers&lt;/b&gt;&lt;br&gt;Async assert, sync release per domain: rst_n_clk60, rst_n_clk_bit&lt;br&gt;Inputs: por_req (power sequencer), RESETB&lt;br&gt;Reset held until pll_lock and pwr_good&lt;br&gt;Analog resets: pll_rst, cdr_rst" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="580" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;Power Sequencer / Power-Good Monitor&lt;/b&gt;&lt;br&gt;Power-up: pwr_good -&gt; bias_en -&gt; pll_en -&gt; wait lock -&gt; release reset -&gt; isolation off&lt;br&gt;Suspend: TX, HS RX and PLL off; FS/LS receiver, squelch and resume detect stay on&lt;br&gt;iso_en clamps powered-down analog domains; ldo_en / bias_en control; pwr_good filtered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="730" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l6" value="&lt;b&gt;Trim / Enable Register Block&lt;/b&gt;&lt;br&gt;Config-bus slave: trims (HS driver current, HS termination, squelch / disconnect thresholds, VBUS comparator thresholds, PLL / CDR bias, LDO)&lt;br&gt;Analog enables, bypass and test bits&lt;br&gt;Shadow registers + update strobe (glitch-free load); safe reset defaults; optional OTP / fuse load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="880" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l7" value="&lt;b&gt;Receiver Status Sync + Glitch Filter&lt;/b&gt;&lt;br&gt;2-FF sync (clk60): rxdp, rxdm, rxrcv (FS/LS)&lt;br&gt;Squelch and HS-disconnect: sync + programmable filter (N clk60 cycles)&lt;br&gt;Feeds SE0 / J / K qualification in the Line State detector&lt;br&gt;Outputs: rxdp_s, rxdm_s, rxrcv_s, squelch_s, disc_s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="1030" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l8" value="&lt;b&gt;Termination / Pull Control Outputs&lt;/b&gt;&lt;br&gt;Output registers (hazard-free): dp_pullup_en (1.5 kOhm), hs_term_en, dp_pulldown_en, dm_pulldown_en&lt;br&gt;Switch only on a clk60 edge, ordered (HS termination off before pull-up on)&lt;br&gt;Safe default on reset / isolation: all off (no pull-up = disconnected)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="1180" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l9" value="&lt;b&gt;VBUS / ID Interface&lt;/b&gt;&lt;br&gt;Controls out: id_pullup, drvvbus, chrg_vbus, dischrg_vbus&lt;br&gt;Status in: a_vbus_vld, sess_vld, sess_end, id_gnd (2-FF sync + filter)&lt;br&gt;Comparator thresholds set via trim registers&lt;br&gt;Slow signals: optional ms-range debounce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="1330" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l10" value="&lt;b&gt;Analog Test / DFT Mux&lt;/b&gt;&lt;br&gt;Analog test bus select (atb_sel), scan isolation at the boundary&lt;br&gt;Digital loopback (TX to RX) bypass of analog&lt;br&gt;Force / observe analog nodes in test mode, BIST hooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;arcSize=4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="1480" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- Level shifter / isolation band -->
        <mxCell id="band" value="&lt;b&gt;LEVEL SHIFTERS + ISOLATION CELLS&lt;/b&gt; (VDD18 &amp;lt;-&amp;gt; VDDA, controls by iso_en / ls_en)" style="rounded=0;whiteSpace=wrap;html=1;horizontal=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="130" width="80" height="1470" as="geometry"/>
        </mxCell>

        <!-- Analog blocks -->
        <mxCell id="a1" value="&lt;b&gt;Transmitter&lt;/b&gt;&lt;br&gt;HS current-mode driver, FS/LS driver, slew control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="130" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;PLL + CDR&lt;/b&gt;&lt;br&gt;480 MHz bit clock, 60 MHz clk60, data recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="280" width="340" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;1.8 V Regulator + Bias&lt;/b&gt;&lt;br&gt;digital supply, power-good" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="730" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;Analog Trim / Bias Distribution&lt;/b&gt;&lt;br&gt;decoded trims and enables fan out to TX, RX, PLL / CDR, comparators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="880" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="&lt;b&gt;Receiver&lt;/b&gt;&lt;br&gt;HS diff receiver, squelch + disconnect comparators, FS/LS diff + single-ended receivers (DP, DN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="1030" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a8" value="&lt;b&gt;Termination / Pull Resistors&lt;/b&gt;&lt;br&gt;1.5 kOhm DP pull-up (switchable), HS 45 Ohm terminations, 15 kOhm pull-downs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="1180" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a9" value="&lt;b&gt;VBUS Comparators / ID Detect&lt;/b&gt;&lt;br&gt;(OTG, optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="1330" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a10" value="&lt;b&gt;Analog Test Bus&lt;/b&gt;&lt;br&gt;test pad / probe access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="1480" width="340" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="Legend: green = data-path boundary, purple = clock / reset / power, yellow = trim and enable registers, blue = control / status groups, orange = level shifter and isolation band, grey dashed = neighbouring digital blocks, red = analog blocks. Names ending in _A are VDDA-domain signals, _s = synchronized, _r = retimed. In the first overall diagram the TX data, RX data and line-state paths were drawn directly between digital and analog; here they are routed through the same boundary cells. The VDDA level (e.g. 3.3 V) and signal names are assumptions to be confirmed with the analog team." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="1660" width="1340" height="90" as="geometry"/>
        </mxCell>

        <!-- Row 1: TX data -->
        <mxCell id="e1a" value="txd, tx_en, tx_se0, speed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x1" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1b" value="txd_r, tx_en_r, tx_se0_r" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0408;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="band"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1c" value="TXD_A, TX_EN_A, TX_SE0_A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.0408;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="band" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Row 2: RX data -->
        <mxCell id="e2a" value="RXD_A, CLK_BIT_A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2222;exitDx=0;exitDy=0;entryX=1;entryY=0.1429;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="band"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2b" value="rxd, clk_bit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=0;exitY=0.1429;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="band" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2c" value="rxd, clk_bit (recovered)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Row 3: PLL / CDR control -->
        <mxCell id="e3a" value="PLL_EN, CDR_EN, REFSEL&lt;br&gt;/ LOCK, CLK60_A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2449;exitDx=0;exitDy=0;entryX=0;entryY=0.7778;entryDx=0;entryDy=0;" edge="1" parent="1" source="band" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3b" value="pll_en, cdr_en, refsel&lt;br&gt;/ pll_lock, clk60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2449;entryDx=0;entryDy=0;" edge="1" parent="1" source="l3" target="band"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3c" value="REFCLK sel, PLL ctrl/lock&lt;br&gt;CLK60, resets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1429;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xclk" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Row 4: reset sync -->
        <mxCell id="e4" value="rst_n_clk60, rst_n_clk_bit&lt;br&gt;/ por_n, RESETB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xclk" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Row 5: power sequencer -->
        <mxCell id="e5a" value="suspendm, power state&lt;br&gt;/ pwr_good_s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8571;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xclk" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5b" value="ldo_en, bias_en, iso_en&lt;br&gt;/ pwr_good" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.449;entryDx=0;entryDy=0;" edge="1" parent="1" source="l5" target="band"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5c" value="LDO_EN, BIAS_EN&lt;br&gt;/ PWR_GOOD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.449;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="band" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v1" value="por_req" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l5" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v2" value="pll_rst, cdr_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v3" value="seq_en, seq_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeWidth=2;fontSize=8;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell>

